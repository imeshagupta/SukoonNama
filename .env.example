# Copy to .env and fill in real values. Never commit .env.

# --- Firebase web config (public; safe to expose in the browser) ---
# Firebase Console -> Project settings -> General -> Your apps -> Web app config
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=sukoonnama.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=sukoonnama
REACT_APP_FIREBASE_STORAGE_BUCKET=sukoonnama.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# --- EmailJS (public keys) ---
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# --- Firebase Admin SDK (SERVER ONLY - never prefix with REACT_APP_) ---
# Option A: base64-encoded service account JSON
FIREBASE_SERVICE_ACCOUNT=
# Option B: path to the service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=scripts/serviceAccountKey.json
