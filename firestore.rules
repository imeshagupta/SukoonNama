rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public content: readable by everyone.
    match /poems/{poemId} {
      allow read: if true;
      // Visitors may bump the like counter.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      // Admin panel may add, edit and delete poems (CMS has no Firebase Auth yet).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'poem', 'category', 'likes']);
      allow create: if true;
      allow delete: if true;
    }

    match /faqs/{faqId} {
      allow read: if true;
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
    }

    match /testimonials_pending/{testimonialId} {
      allow read: if true;
      allow create: if true;
    }

    // Admin/CMS writes stay blocked until Firebase Auth is added.
  }
}
